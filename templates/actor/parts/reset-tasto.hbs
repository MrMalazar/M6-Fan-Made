{{!-- Il tasto di reset di una parte della scheda (Blue, 11/9): sta a sinistra
     del titolo della sua sezione, nero e rosso, con «Reset» sotto l'icona, e
     si vede solo con «Mostra i tasti di reset» acceso nel memo di creazione.
     Contesto: {id, label, icon}; locked da @root. --}}
<button type="button" class="m6-reset-tasto" data-action="resetSection" data-reset="{{id}}" title="{{label}}" aria-label="{{label}}" {{#if @root.locked}}disabled{{/if}}>
    <i class="fa-solid {{icon}}" aria-hidden="true"></i>
    <span>{{localize "M6.Reset.Word"}}</span>
</button>
