{{!-- Identità (20/9): il ritratto grande, coi tasti dei ritratti in alto a
     destra e, posati sul bordo basso in velatura, Nuova sessione e Cambio
     Scena (restano sopra l'immagine, ma non si prendono una riga). Sotto,
     il nome come titolo (è ancora un campo: la scheda sbloccata lo scrive),
     poi sulla stessa riga il giocatore e l'Appartenenza a tendina. --}}
<section class="m6-riq m6-riq-identita">
    {{!-- Col memo di creazione acceso (23/9): il titolo si colora e dice se il Concetto è scritto. --}}
    <header class="m6-riq-title{{#if memo.on}} memo-{{memo.boxes.identita.state}}{{/if}}">
        <span>{{localize "M6.Stat.Identita"}}{{#if memo.on}} <b class="m6-memo-conto" title="{{localize 'M6.Riepilogo.Concept'}}"><i class="fa-solid {{#if memo.boxes.identita.concetto}}fa-circle-check{{else}}fa-circle-xmark{{/if}}" aria-hidden="true"></i> {{localize "M6.Riepilogo.ConceptBreve"}}</b>{{/if}}</span>
    </header>
    <div class="m6-riq-body">
        <div class="m6-ritratto">
            <img class="profile-img m6-ritratto-img" data-action="editImage" src="{{img}}" data-edit="img" title="{{actor.name}}"/>
            {{!-- In alto a destra, dentro lo slot: gira i ritratti; il più ne aggiunge uno, il meno toglie quello che si vede. --}}
            <div class="m6-ritratto-tasti">
                {{#if ritratti.many}}
                    <button type="button" data-action="ritrattoNext" title="{{localize 'M6.Ritratti.NextHint'}}" aria-label="{{localize 'M6.Ritratti.NextHint'}}"><i class="fa-solid fa-rotate" aria-hidden="true"></i><small>{{ritratti.position}}/{{ritratti.count}}</small></button>
                {{/if}}
                {{#unless locked}}
                    <button type="button" data-action="ritrattoAdd" title="{{localize 'M6.Ritratti.AddHint'}}" aria-label="{{localize 'M6.Ritratti.AddHint'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
                    {{#if ritratti.many}}
                        <button type="button" data-action="ritrattoRemove" title="{{localize 'M6.Ritratti.RemoveHint'}}" aria-label="{{localize 'M6.Ritratti.RemoveHint'}}"><i class="fa-solid fa-minus" aria-hidden="true"></i></button>
                    {{/if}}
                {{/unless}}
            </div>
            {{!-- La fascia bassa: i due tasti di sessione, in velatura sul ritratto. --}}
            <div class="m6-identita-tasti">
                <button type="button" class="m6-new-session" data-action="saluteNewSession" title="{{localize 'M6.Salute.NewSessionHint'}}">
                    <i class="fa-solid fa-sun" aria-hidden="true"></i> {{localize "M6.Salute.NewSession"}}
                </button>
                <button type="button" class="m6-new-session m6-cambio-scena" data-action="saluteCambioScena" title="{{localize 'M6.Salute.CambioScenaHint'}}">
                    <i class="fa-solid fa-clapperboard" aria-hidden="true"></i> {{localize "M6.Salute.CambioScena"}}{{#if salute.locked}} <b class="m6-cambio-scena-count">{{salute.locked}}</b>{{/if}}
                </button>
            </div>
        </div>

        <div class="m6-names">
            <div class="flexrow name-field{{#if locked}} clickthrough{{/if}}">
                {{#if locked}}
                    <div class="charname">{{name}}</div>
                {{else}}
                    <input class="charname" name="name" type="text" value="{{name}}" placeholder="{{localize 'M6.Comuni.Name'}}"/>
                {{/if}}
            </div>
            {{!-- Giocatore · Appartenenza: il campo del giocatore a sinistra, la
                 linguetta dell'Appartenenza a destra sulla stessa riga; la
                 tendina si apre sotto, a tutta larghezza. --}}
            <div class="m6-identita-sotto">
                <div class="m6-player-field">
                    <input class="m6-player" name="flags.m6.player" type="text" value="{{playerName}}" placeholder="{{localize 'M6.Header.Player'}}" aria-label="{{localize 'M6.Header.Player'}}" {{#if locked}}disabled{{/if}}/>
                </div>
                {{> "systems/m6/templates/actor/parts/appartenenza.hbs"}}
            </div>
        </div>
    </div>
</section>
