{{!-- Una riga degli Strumenti per la Magick, su una linea sola in colonne
     allineate (Blue, 24/9 sera): il sigillo della Sfera (o Percepire, 9/9),
     la pastiglia dello Strumento (tratteggiata finché non c'è, viola col nome
     quando c'è) che apre col clic la tendina dei ventidue per famiglia, il
     mestiere quando serve (altrimenti la colonna resta vuota, così le caselle
     del testo stanno incolonnate), il tuo di preciso, la lampadina dei consigli
     (non per Percepire). Sotto, la tendina; le note stanno nel sorvolo della pastiglia. --}}
<div class="m6-riga m6-riga-apribile m6-focus-instrument con-tendina{{#if row.sharedWith.length}} shared{{/if}}{{#if row.outsideForm}} outside{{/if}}{{#if row.perceive}} perceive{{/if}}" data-cassetto="strumento-{{row.id}}">
    <div class="m6-riga-testa m6-strumento-riga" title="{{localize row.label}}">
        {{#if row.faIcon}}<i class="{{row.faIcon}} m6-riga-icona" aria-hidden="true"></i>{{else}}<img class="m6-riga-icona m6-sfera-sigillo" src="{{row.icon}}" alt="{{localize row.label}}">{{/if}}
        {{!-- Le note (Percepire, lo Strumento in comune, fuori dal Tipo) stanno nel sorvolo della pastiglia: niente frasi in corsivo sotto la riga (Blue, 25/9). --}}
        <button type="button" class="m6-sfera-potere m6-strumento-pastiglia{{#if row.tool}} pieno{{/if}}" data-action="cassettoToggle" title="{{localize row.label}} · {{localize 'M6.Focus.ToolPick'}}{{#if row.perceive}}
{{localize 'M6.Focus.PerceiveToolHint'}}{{/if}}{{#if row.sharedWith.length}}
{{localize 'M6.Focus.SharedTool' others=row.sharedList}}{{/if}}{{#if row.outsideForm}}
{{localize 'M6.Focus.ToolOutsideType'}}{{/if}}" aria-label="{{localize row.label}}: {{localize 'M6.Focus.Tool'}}" {{#if locked}}disabled{{/if}}>
            <span>{{#if row.tool}}{{row.toolLabel}}{{else}}{{localize "M6.Focus.ToolScegli"}}{{/if}}</span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
        </button>
        {{#if row.needsProfession}}
            <input type="text" class="m6-focus-instrument-profession" name="flags.m6.focus.sphereInstruments.{{row.id}}.profession" value="{{row.profession}}" placeholder="{{localize 'M6.Focus.ProfessionHint'}}" aria-label="{{localize row.label}}: {{localize 'M6.Focus.Profession'}}" {{#if locked}}disabled{{/if}}>
        {{else}}
            <span class="m6-strumento-vuoto" aria-hidden="true"></span>
        {{/if}}
        <input type="text" class="m6-focus-instrument-name" name="flags.m6.focus.sphereInstruments.{{row.id}}.name" value="{{row.name}}" placeholder="{{localize 'M6.Focus.Detail'}}" aria-label="{{localize row.label}}: {{localize 'M6.Focus.Detail'}}" {{#if locked}}disabled{{/if}}>
        {{#if row.perceive}}
            <span class="m6-strumento-vuoto" aria-hidden="true"></span>
        {{else}}
            {{!-- La lampadina: i consigli dal Credo, dalla Famiglia e dalla Sottofamiglia. --}}
            <button type="button" class="m6-riga-tastino m6-archivio-open m6-focus-instrument-suggest" data-action="strumentiSuggest" data-sphere="{{row.id}}" title="{{localize 'M6.Focus.Suggest'}}" aria-label="{{localize 'M6.Focus.Suggest'}}"><i class="fa-solid fa-lightbulb" aria-hidden="true"></i></button>
        {{/if}}
    </div>
    {{!-- La tendina degli Strumenti (si apre sotto tutta la riga): un occhiello per famiglia, le pastiglie; lo stesso cliccato di nuovo si toglie. --}}
    <div class="m6-cassetto m6-cassetto-strumenti" role="group" aria-label="{{localize row.label}}: {{localize 'M6.Focus.Tool'}}">
        {{#each row.families as |family|}}
            <span class="m6-riq-occhiello{{#unless family.allowed}} spenta{{/unless}}">{{family.label}}{{#unless family.allowed}} · {{localize "M6.Focus.FamigliaFuori"}}{{/unless}}</span>
            <div class="m6-pastiglie-fila sinistra{{#unless family.allowed}} spenta{{/unless}}">
                {{#each family.tools as |tool|}}
                    <button type="button" class="m6-pastiglia m6-pastiglia-modo{{#if tool.selected}} scelta{{/if}}" data-action="strumentoPick" data-sphere="{{../../row.id}}" data-tool="{{tool.id}}" aria-pressed="{{tool.selected}}" {{#unless family.allowed}}disabled{{/unless}}>{{tool.label}}</button>
                {{/each}}
            </div>
        {{/each}}
    </div>
</div>
