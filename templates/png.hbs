{{!-- La scheda nuda del PNG: testata, le tre riserve, il Tiro, la Salute.
     Il nome di una riserva è il tasto che la mette nel tiro, il numero sono i
     dadi che tira lui. --}}
<div class="m6-foglio">
    <header class="m6-testa">
        <img class="m6-ritratto" src="{{document.img}}" alt="" data-edit="img" data-action="editImage">
        <input class="m6-nome" type="text" name="name" value="{{document.name}}" placeholder="{{localize 'M6.Scheda.Nome'}}" aria-label="{{localize 'M6.Scheda.Nome'}}">
    </header>

    <div class="m6-colonna">
        <section class="m6-riq">
            <h3 class="m6-titolo">{{localize "M6.Titoli.Riserve"}}</h3>
            {{#each riserve as |riga|}}
                <div class="m6-riga{{#if riga.scelto}} scelta{{/if}}">
                    <button type="button" class="m6-riga__nome" data-action="sceglie" data-tipo="campo" data-id="{{riga.id}}" aria-pressed="{{riga.scelto}}" title="{{localize 'M6.Tiro.ScegliRiserva'}}">{{riga.nome}}</button>
                    <input class="m6-numero" type="number" name="{{riga.percorso}}" value="{{riga.dadi}}" min="0" step="1" aria-label="{{riga.nome}}: {{localize 'M6.Tiro.Dadi'}}">
                </div>
            {{/each}}
        </section>

        {{> "systems/m6/templates/parti/tiro.hbs"}}
        {{> "systems/m6/templates/parti/salute.hbs"}}
    </div>
</div>
