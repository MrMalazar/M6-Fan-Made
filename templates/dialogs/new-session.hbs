<form class="dialog-contents m6-item-form">
    <p class="m6-arete-hint">{{localize "M6.Salute.NewSessionHint"}}</p>
    <label class="m6-item-field">
        <span class="m6-arete-row-label">{{localize "M6.Salute.SessionXp"}}</span>
        <input type="number" name="experience" min="0" max="99" step="1" value="0" autofocus>
        <small>{{localize "M6.Salute.SessionXpHint"}}</small>
    </label>
    <label class="m6-item-field">
        <span class="m6-arete-row-label">{{localize "M6.Experience.GainsWhen"}}</span>
        <input type="text" name="when" value="{{when}}">
    </label>
</form>
