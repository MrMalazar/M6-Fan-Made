{{!-- Il Tiro: a sinistra la Riserva (chi dà dadi), a destra la Soglia (i successi che servono).
     Spento, il tasto dice cosa manca. --}}
<section class="m6-riq m6-riq--tiro">
    <h3 class="m6-titolo">{{localize "M6.Titoli.Tiro"}}</h3>
    <div class="m6-tiro">
        <div class="m6-tiro__colonna">
            <span class="m6-occhiello">{{localize "M6.Tiro.Riserva"}}</span>
            {{#each tiro.voci as |voce|}}
                <div class="m6-tiro__voce{{#unless voce.scelta}} vuota{{/unless}}"><span>{{voce.nome}}</span><b>{{voce.valore}}</b></div>
            {{/each}}
            {{#if tiro.totale}}<div class="m6-tiro__totale">{{tiro.dadi}}</div>{{/if}}
        </div>
        <div class="m6-tiro__colonna">
            <span class="m6-occhiello">{{localize "M6.Tiro.Soglia"}}</span>
            <div class="m6-soglie" role="group" aria-label="{{localize 'M6.Tiro.Soglia'}}">
                {{#each tiro.soglie as |passo|}}<button type="button" class="m6-soglia{{#if passo.scelta}} scelta{{/if}}" data-action="soglia" data-valore="{{passo.valore}}" aria-pressed="{{passo.scelta}}">{{passo.valore}}</button>{{/each}}
            </div>
        </div>
    </div>
    <button type="button" class="m6-tira" data-action="tira"{{#unless tiro.pronto}} disabled{{/unless}}>{{tiro.tasto}}</button>
</section>
