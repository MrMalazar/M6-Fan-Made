{{!-- La Salute: un tracciato solo. I danni fisici si dipingono da sinistra, quelli mentali da destra.
     Una riga per segno: il meno a sinistra, il più a destra, poi il nome. --}}
<section class="m6-riq m6-riq--salute">
    <h3 class="m6-titolo">
        <span>{{localize "M6.Titoli.Salute"}}</span>
        <span class="m6-caselle">
            <button type="button" class="m6-passo" data-action="caselle" data-passo="-1" title="{{localize 'M6.Salute.Meno'}}" aria-label="{{localize 'M6.Salute.Meno'}}">−</button>
            <b title="{{localize 'M6.Salute.Caselle'}}">{{salute.caselle}}</b>
            <button type="button" class="m6-passo" data-action="caselle" data-passo="1" title="{{localize 'M6.Salute.Piu'}}" aria-label="{{localize 'M6.Salute.Piu'}}">+</button>
        </span>
    </h3>
    <div class="m6-tracciato" role="img" aria-label="{{localize 'M6.Titoli.Salute'}}">
        {{#each salute.celle as |cella|}}<span class="m6-casella" data-stato="{{cella.stato}}" title="{{cella.nome}}"></span>{{/each}}
    </div>
    {{#if salute.stato}}<p class="m6-stato">{{salute.stato}}</p>{{/if}}
    {{#each salute.righe as |riga|}}
        <div class="m6-segno">
            <button type="button" class="m6-passo" data-action="segno" data-segno="{{riga.segno}}" data-passo="-1" aria-label="{{riga.nome}} −1">−</button>
            <b>{{riga.conto}}</b>
            <button type="button" class="m6-passo" data-action="segno" data-segno="{{riga.segno}}" data-passo="1" aria-label="{{riga.nome}} +1">+</button>
            <span class="m6-casella" data-stato="{{riga.segno}}" aria-hidden="true"></span>
            <span class="m6-segno__nome">{{riga.nome}}</span>
        </div>
    {{/each}}
</section>
