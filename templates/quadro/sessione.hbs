{{!-- La Nuova sessione dentro il Quadro (Blue, 27/9): al posto della finestra, una pagina che
     prende il posto del modo in uso: i maghi del Quadro in breve (ritratto, nome, chi li muove,
     la × per toglierli), dove trascinare dagli Attori chi manca (come nei Giocatori), la prima
     scena e il posto, poi Inizia. Annulla torna al modo di prima. --}}
<div class="m6-quadro-corpo m6-quadro-sessione">
    <div class="m6-quadro-riga-testa">
        <span><i class="fa-solid fa-sun" aria-hidden="true"></i> {{localize "M6.Paradosso.NewSession"}} · {{localize "M6.Menu.InGioco" n=maghi.length}}</span>
        <span class="m6-quadro-trascina" data-role="trascina"><i class="fa-solid fa-hand-pointer" aria-hidden="true"></i> {{localize "M6.Menu.TrascinaQui"}}</span>
    </div>
    <p class="m6-quadro-sessione-spiega">{{localize "M6.Menu.SessioneSpiega"}}</p>
    <div class="m6-quadro-sessione-maghi">
        {{#each maghi as |m|}}
            <div class="m6-quadro-sessione-mago">
                <img class="ritratto" src="{{m.img}}" alt="">
                <span class="nome">{{m.name}}</span>
                <span class="gioc">{{#each m.utenti as |u|}}<i class="punto{{#if u.active}} on{{/if}}" aria-hidden="true"></i> {{u.name}}{{#unless @last}} · {{/unless}}{{else}}<i class="punto" aria-hidden="true"></i> {{localize "M6.Menu.SenzaGiocatore"}}{{/each}}</span>
                <button type="button" class="ghost piccolo" data-action="magoTogli" data-id="{{m.id}}" title="{{localize 'M6.Menu.Togli'}}" aria-label="{{localize 'M6.Menu.Togli'}}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
            </div>
        {{else}}
            <p class="m6-quadro-vuoto">{{localize "M6.Menu.NessunMago"}}</p>
        {{/each}}
    </div>
    <div class="m6-quadro-sessione-scelte">
        <label class="m6-quadro-campo"><span>{{localize "M6.Menu.PrimaScena"}}</span>
            <select name="scena"><option value="">{{localize "M6.Menu.NessunaScena"}}</option>{{#each scene as |s|}}<option value="{{s.id}}" {{#if s.selected}}selected{{/if}}>{{s.nome}}</option>{{/each}}</select>
        </label>
        <label class="m6-quadro-campo"><span>{{localize "M6.Menu.Posto"}}</span>
            <select name="posto">{{#each posti as |p|}}<option value="{{p.id}}" {{#if p.selected}}selected{{/if}}>{{p.label}}</option>{{/each}}</select>
        </label>
    </div>
    <p class="m6-quadro-hint">{{localize "M6.Menu.SessioneAzzera" points=points}}</p>
    <div class="m6-quadro-tasti">
        <button type="button" data-action="sessioneInizia" {{#if nessunMago}}disabled{{/if}}><i class="fa-solid fa-play" aria-hidden="true"></i> {{localize "M6.Menu.Inizia"}}</button>
        <button type="button" class="ghost" data-action="sessioneAnnulla"><i class="fa-solid fa-xmark" aria-hidden="true"></i> {{localize "M6.Menu.SessioneAnnulla"}}</button>
    </div>
</div>
