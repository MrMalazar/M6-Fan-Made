{{!-- Passo 4 · il Tipo di Magick: tre carte. --}}
<section class="m6-guidata-riq m6-guidata-cosa">
    <header class="m6-guidata-riq-titolo"><span>{{localize "M6.Guidata.Cosa"}}</span><small>{{passo.sotto}}</small></header>
    <h2 class="m6-guidata-domanda">{{passo.domanda}}</h2>
    <div class="m6-guidata-carte carte-tipi">
        {{#each corpo.tipi as |tipo|}}
            <button type="button" class="m6-guidata-carta larga{{#if tipo.selected}} scelta{{/if}}{{#if tipo.consigliato}} del-credo{{/if}}" data-action="tipoScegli" data-form="{{tipo.id}}" aria-pressed="{{tipo.selected}}" {{#unless @root.canEdit}}disabled{{/unless}}>
                <span class="m6-guidata-arte simbolo"><i class="{{tipo.icon}}" aria-hidden="true"></i></span>
                <h4>{{tipo.label}}</h4>
                <span class="m6-guidata-sfere">
                    <small>{{localize "M6.Guidata.Tipo.Famiglie"}}: {{#each tipo.famiglie as |f|}}{{#if @index}}, {{/if}}{{f}}{{/each}}</small>
                    {{#if tipo.consigliato}}<small class="m6-guidata-tag oro">{{localize "M6.Guidata.Tipo.Consigliato"}}</small>{{/if}}
                </span>
            </button>
        {{/each}}
    </div>
    {{#if corpo.pratica}}
        <p class="m6-guidata-nota-passo">{{localize "M6.Guidata.Tipo.Pratica"}}: <b>{{corpo.pratica}}</b>{{#if corpo.praticaTipo}} · {{localize "M6.Guidata.Tipo.Consigliato"}}: <b>{{corpo.praticaTipo}}</b>{{else}} · {{localize "M6.Guidata.Tipo.Nessuna"}}{{/if}}</p>
    {{/if}}
</section>
<aside class="m6-guidata-spiega">
    {{> "systems/m6/templates/guidata/perche.hbs"}}
    <section class="m6-guidata-riq m6-guidata-guadagni">
        <header class="m6-guidata-riq-titolo"><span>{{localize "M6.Guidata.Guadagni"}}</span></header>
        <div class="m6-guidata-voci">
            <div class="m6-guidata-voce"><i class="fa-solid fa-hand-sparkles" aria-hidden="true"></i> {{localize "M6.Guidata.Tipo.Famiglie"}} <b>{{#if corpo.chosen}}{{#each corpo.chosen.famiglie as |f|}}{{#if @index}}, {{/if}}{{f}}{{/each}}{{else}}…{{/if}}</b></div>
            <div class="m6-guidata-voce"><i class="fa-solid fa-toolbox" aria-hidden="true"></i> {{localize "M6.Guidata.Credo.Strumenti"}} <b>{{localize "M6.Guidata.Credo.NelPasso" n=8}}</b></div>
        </div>
    </section>
</aside>
