{{!-- La scheda di un oggetto: nome, immagine, i campi del suo tipo (dalla tavola di campi-oggetto.js), i modificatori, la descrizione. --}}
<section class="m6-oggetto-foglio">
    <header class="m6-oggetto-capo">
        <img src="{{oggetto.img}}" alt="" data-edit="img" data-action="editImage">
        <div>
            <span class="m6-riq-occhiello">{{tipo}}{{#if gruppo}} · {{gruppo}}{{/if}}</span>
            <input type="text" name="name" value="{{oggetto.name}}" aria-label="{{localize 'M6.Comuni.Name'}}">
        </div>
    </header>
    {{#if campi.length}}
    <div class="m6-oggetto-campi">
        {{#each campi as |campo|}}
        {{#if campo.scelta}}
        <label title="{{campo.nota}}"><span>{{campo.etichetta}}</span>
            <select name="{{campo.nome}}">{{#each campo.scelte as |voce|}}<option value="{{voce.id}}" {{#if voce.selected}}selected{{/if}}>{{voce.label}}</option>{{/each}}</select>
        </label>
        {{/if}}
        {{#if campo.numero}}
        <label title="{{campo.nota}}"><span>{{campo.etichetta}}</span><input type="number" name="{{campo.nome}}" value="{{campo.valore}}" min="{{campo.min}}" {{#if campo.max}}max="{{campo.max}}"{{/if}} step="1"></label>
        {{/if}}
        {{#if campo.testo}}
        <label title="{{campo.nota}}"><span>{{campo.etichetta}}</span><input type="text" name="{{campo.nome}}" value="{{campo.valore}}"></label>
        {{/if}}
        {{#if campo.spunta}}
        <label class="m6-oggetto-spunta" title="{{campo.nota}}"><input type="checkbox" name="{{campo.nome}}" {{#if campo.valore}}checked{{/if}}><span>{{campo.etichetta}}</span></label>
        {{/if}}
        {{#if campo.pallini}}
        <div class="m6-oggetto-pallini" title="{{campo.nota}}"><span>{{campo.etichetta}}</span>
            <div class="resource-value" data-value="{{campo.valore}}" data-name="{{campo.nome}}">
                <span class="resource-value-empty" data-action="pallinoVuoto"></span>{{#each campo.passi}}<span class="resource-value-step" data-action="pallino" data-index="{{this}}"></span>{{/each}}
            </div>
        </div>
        {{/if}}
        {{#if campo.usi}}
        <label class="m6-oggetto-spunta"><input type="checkbox" name="{{campo.nome}}.enabled" {{#if campo.acceso}}checked{{/if}}><span>{{campo.etichetta}}</span></label>
        {{#if campo.acceso}}
        <label><span>{{localize "M6.Comuni.Oggetto.UsiRimasti"}}</span><input type="number" name="{{campo.nome}}.current" value="{{campo.rimasti}}" min="0" step="1"></label>
        <label><span>{{localize "M6.Comuni.Oggetto.UsiPieni"}}</span><input type="number" name="{{campo.nome}}.max" value="{{campo.pieni}}" min="0" step="1"></label>
        {{/if}}
        {{/if}}
        {{/each}}
    </div>
    {{/if}}
    {{#if conModificatori}}
    <div class="m6-oggetto-modificatori">
        <span class="m6-riq-occhiello">{{localize "M6.Comuni.Oggetto.Modificatori"}}</span>
        <p class="m6-oggetto-vuoto">{{localize "M6.Comuni.Oggetto.ModNota"}}</p>
        {{#each modificatori as |riga|}}
        <div class="m6-oggetto-modificatore">
            <input type="number" name="modificatori.{{riga.indice}}.value" value="{{riga.valore}}" min="-99" max="99" step="1" aria-label="{{localize 'M6.Comuni.Oggetto.ModDadi'}}">
            <span>{{localize "M6.Comuni.Oggetto.ModDadi"}}</span>
            {{#each riga.tiri as |tiro|}}
            <label class="m6-oggetto-spunta"><input type="checkbox" name="modificatori.{{riga.indice}}.tiri.{{tiro.id}}" {{#if tiro.acceso}}checked{{/if}}><span>{{tiro.label}}</span></label>
            {{/each}}
            {{#if @root.scrivibile}}<button type="button" data-action="modificatoreTogli" data-indice="{{riga.indice}}" aria-label="{{localize 'M6.Comuni.Delete'}}" title="{{localize 'M6.Comuni.Delete'}}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>{{/if}}
        </div>
        {{else}}
        <p class="m6-oggetto-vuoto">{{localize "M6.Comuni.Oggetto.ModVuoto"}}</p>
        {{/each}}
        {{#if scrivibile}}<button type="button" class="m6-oggetto-aggiungi" data-action="modificatoreNuovo"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "M6.Comuni.Oggetto.ModNuovo"}}</button>{{/if}}
    </div>
    {{/if}}
    <span class="m6-riq-occhiello">{{localize "M6.Comuni.Oggetto.Descrizione"}}</span>
    <prose-mirror name="system.description" value="{{system.description}}" toggled="true" compact="true">{{{descrizione}}}</prose-mirror>
</section>
