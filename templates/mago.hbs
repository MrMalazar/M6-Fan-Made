{{!-- La scheda nuda del Mago: testata, Attributi, Abilità, il Tiro, la Salute.
     Il nome di un tratto è il tasto che lo mette nel tiro, i pallini cambiano
     il valore. --}}
<div class="m6-foglio">
    <header class="m6-testa">
        <img class="m6-ritratto" src="{{document.img}}" alt="" data-edit="img" data-action="editImage">
        <input class="m6-nome" type="text" name="name" value="{{document.name}}" placeholder="{{localize 'M6.Scheda.Nome'}}" aria-label="{{localize 'M6.Scheda.Nome'}}">
    </header>

    <div class="m6-griglia">
        <section class="m6-riq">
            <h3 class="m6-titolo">{{localize "M6.Titoli.Attributi"}}</h3>
            {{#each attributi as |gruppo|}}
                <span class="m6-occhiello">{{gruppo.nome}}</span>
                {{#each gruppo.righe as |riga|}}
                    {{> "systems/m6/templates/parti/tratto.hbs" riga suggerimento="M6.Tiro.ScegliAttributo"}}
                {{/each}}
            {{/each}}
        </section>

        <section class="m6-riq">
            <h3 class="m6-titolo">{{localize "M6.Titoli.Abilita"}}</h3>
            {{#each abilita as |gruppo|}}
                <span class="m6-occhiello">{{gruppo.nome}}</span>
                {{#each gruppo.righe as |riga|}}
                    {{> "systems/m6/templates/parti/tratto.hbs" riga suggerimento="M6.Tiro.ScegliAbilita"}}
                {{/each}}
            {{/each}}
        </section>

        <div class="m6-colonna">
            {{> "systems/m6/templates/parti/tiro.hbs"}}
            {{> "systems/m6/templates/parti/salute.hbs"}}
        </div>
    </div>
</div>
